‏<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Str Network - Mining App</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
        body { background-color: #0b132b; color: #ffffff; min-height: 100vh; display: flex; flex-direction: column; justify-content: space-between; padding: 20px; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .menu-btn { background: #1c2541; border: none; color: #fff; font-size: 22px; padding: 10px; border-radius: 12px; cursor: pointer; }
        .profile-badge { display: flex; align-items: center; gap: 10px; background: #1c2541; padding: 8px 15px; border-radius: 20px; }
        .profile-avatar { width: 35px; height: 35px; background: #00ff88; color: #000; font-weight: bold; display: flex; align-items: center; justify-content: center; border-radius: 50%; }
        
        .main-content { text-align: center; flex: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; }
        .status-badge { background: rgba(0, 255, 136, 0.1); border: 1px solid rgba(0, 255, 136, 0.3); color: #00ff88; padding: 6px 16px; border-radius: 20px; font-size: 13px; margin-bottom: 20px; }
        .balance-title { color: #8d99ae; font-size: 14px; margin-bottom: 5px; }
        .balance-value { font-size: 38px; font-weight: bold; color: #fff; margin-bottom: 5px; }
        .balance-usd { color: #8d99ae; font-size: 12px; margin-bottom: 30px; }
        
        .mining-btn-container { width: 190px; height: 190px; border-radius: 50%; background: linear-gradient(135deg, #00ff88, #00b4d8); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 30px rgba(0, 255, 136, 0.3); margin-bottom: 30px; cursor: pointer; }
        .mining-inner { width: 176px; height: 176px; background: #0b132b; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; }
        
        .stats-row { display: flex; gap: 15px; width: 100%; max-width: 400px; }
        .stat-card { background: #1c2541; flex: 1; padding: 15px; border-radius: 14px; text-align: right; }
        .stat-card div:first-child { color: #8d99ae; font-size: 11px; margin-bottom: 5px; }
        .stat-card div:last-child { font-weight: bold; font-size: 14px; color: #fff; }

        /* نافذة القائمة الجانبية */
        .drawer { position: fixed; top: 0; right: -280px; width: 280px; height: 100%; background: #1c2541; transition: 0.3s ease; z-index: 1000; padding: 20px; box-shadow: -5px 0 15px rgba(0,0,0,0.5); }
        .drawer.open { right: 0; }
        .drawer-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; border-bottom: 1px solid #2b3a67; padding-bottom: 15px; }
        .drawer-item { padding: 12px 0; color: #fff; font-size: 15px; border-bottom: 1px solid rgba(255,255,255,0.05); cursor: pointer; display: flex; align-items: center; gap: 12px; }
        .overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: none; z-index: 999; }
        .overlay.show { display: block; }
    </style>
</head>
<body>

    <header>
        <button class="menu-btn" onclick="toggleDrawer()">☰</button>
        <div class="profile-badge">
            <div class="profile-avatar">M</div>
            <div>
                <div style="font-size: 13px; font-weight: bold;">مازن</div>
                <div style="font-size: 10px; color: #00ff88;">حساب موثق</div>
            </div>
        </div>
    </header>

    <div class="main-content">
        <div class="status-badge">🟢 جلسة التعدين نشطة ومستمرة</div>
        <div class="balance-title">إجمالي الأرباح المكتسبة</div>
        <div class="balance-value" id="balanceDisplay">457.2000</div>
        <div class="balance-usd">USD 160.02 : القيمة التقديرية</div>

        <div class="mining-btn-container">
            <div class="mining-inner">
                <div style="font-size: 24px; margin-bottom: 5px;">⚡</div>
                <div style="font-weight: bold; font-size: 16px; color: #00ff88;">جاري التعدين</div>
                <div style="font-size: 11px; color: #8d99ae; margin-top: 3px;" id="timerDisplay">23:59:45</div>
            </div>
        </div>

        <div class="stats-row">
            <div class="stat-card">
                <div>المتبقي بالجلسة</div>
                <div id="sessionTimer">23:59:45</div>
            </div>
            <div class="stat-card">
                <div>معدل التعدين</div>
                <div>1.20 STR/ساعة</div>
            </div>
        </div>
    </div>

    <!-- القائمة الجانبية -->
    <div class="overlay" id="overlay" onclick="toggleDrawer()"></div>
    <div class="drawer" id="drawer">
        <div class="drawer-header">
            <h3>قائمة التطبيق</h3>
            <button onclick="toggleDrawer()" style="background:none; border:none; color:#fff; font-size:20px; cursor:pointer;">✕</button>
        </div>
        <div class="drawer-item">⚡ جلسة التعدين الحالية</div>
        <div class="drawer-item">📋 المهام اليومية (Tasks)</div>
        <div class="drawer-item">👥 فريق الإحالات (Referrals)</div>
        <div class="drawer-item">👛 المحفظة والسحب (Wallet)</div>
        <div class="drawer-item">⚙️ إعدادات الحساب</div>
    </div>

    <script>
        // محاكاة نظام التعدين وزيادة الرصيد لحظياً وحفظه محلياً
        let balance = parseFloat(localStorage.getItem('str_balance')) || 457.2000;
        const miningRate = 1.20; // معدل بالساعة
        
        setInterval(() => {
            balance += (miningRate / 3600);
            document.getElementById('balanceDisplay').innerText = balance.toFixed(4);
            localStorage.setItem('str_balance', balance);
        }, 1000);

        function toggleDrawer() {
            document.getElementById('drawer').classList.toggle('open');
            document.getElementById('overlay').classList.toggle('show');
        }
    </script>
</body>
</html>
