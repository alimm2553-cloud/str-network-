<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Str Network - Mining App</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
        body { background-color: #0b132b; color: #ffffff; min-height: 100vh; display: flex; flex-direction: column; justify-content: space-between; padding: 20px; }
        header { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; }
        .menu-btn { background: #1c2541; border: none; color: white; padding: 10px; border-radius: 12px; font-size: 18px; cursor: pointer; }
        .profile-badge { display: flex; align-items: center; gap: 10px; background: #1c2541; padding: 6px 14px; border-radius: 30px; }
        .profile-avatar { width: 35px; height: 35px; background: #00ff88; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; color: #0b132b; }
        .main-content { text-align: center; margin: auto 0; }
        .status-badge { background: rgba(0, 255, 136, 0.1); color: #00ff88; display: inline-block; padding: 6px 16px; border-radius: 20px; font-size: 14px; margin-bottom: 25px; border: 1px solid rgba(0, 255, 136, 0.3); }
        .balance-title { color: #8d99ae; font-size: 16px; margin-bottom: 5px; }
        .balance-value { font-size: 38px; font-weight: bold; color: #ffffff; margin-bottom: 5px; }
        .balance-usd { color: #8d99ae; font-size: 15px; margin-bottom: 40px; }
        .mining-btn-container { width: 190px; height: 190px; margin: 0 auto 30px; background: linear-gradient(135deg, #1c2541, #0b132b); border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 30px rgba(0, 255, 136, 0.15); border: 3px solid #1c2541; cursor: pointer; transition: 0.3s; }
        .mining-inner { width: 150px; height: 150px; background: #00ff88; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #0b132b; font-weight: bold; box-shadow: 0 0 20px rgba(0, 255, 136, 0.4); }
        .mining-inner span:first-child { font-size: 22px; margin-bottom: 3px; }
        .mining-inner span:last-child { font-size: 13px; opacity: 0.8; }
        .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px; }
        .stat-card { background: #1c2541; padding: 15px; border-radius: 16px; text-align: center; }
        .stat-title { color: #8d99ae; font-size: 13px; margin-bottom: 5px; }
        .stat-value { font-size: 18px; font-weight: bold; color: #ffffff; }
        footer { text-align: center; color: #8d99ae; font-size: 12px; padding: 10px 0; }
    </style>
</head>
<body>
    <header>
        <button class="menu-btn">☰</button>
        <div class="profile-badge">
            <span>مازن</span>
            <div class="profile-avatar">م</div>
        </div>
    </header>

    <div class="main-content">
        <div class="status-badge" id="statusText">التعدين متوقف حالياً</div>
        
        <div class="balance-title">رصيد شبكة ستر</div>
        <div class="balance-value" id="balance">0.0000 STR</div>
        <div class="balance-usd">≈ $0.00 USD</div>

        <div class="mining-btn-container" id="miningBtn" onclick="toggleMining()">
            <div class="mining-inner">
                <span id="btnText">ابدأ</span>
                <span id="btnSub">التعدين</span>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-title">سرعة التعدين</div>
                <div class="stat-value">0.20 STR/ساعة</div>
            </div>
            <div class="stat-card">
                <div class="stat-title">المعدّلون النشطون</div>
                <div class="stat-value">1,420</div>
            </div>
        </div>
    </div>

    <footer>
        Str Network © 2026 - جميع الحقوق محفوظة
    </footer>

    <script>
        let isMining = false;
        let balance = 0.0000;
        let timer = null;

        function toggleMining() {
            const statusText = document.getElementById('statusText');
            const btnText = document.getElementById('btnText');
            const btnSub = document.getElementById('btnSub');
            const miningBtn = document.getElementById('miningBtn');

            if (!isMining) {
                isMining = true;
                statusText.innerText = "التعدين جارٍ الآن...";
                statusText.style.color = "#00ff88";
                statusText.style.borderColor = "rgba(0, 255, 136, 0.6)";
                btnText.innerText = "إيقاف";
                btnSub.innerText = "نشط";
                miningBtn.style.boxShadow = "0 0 40px rgba(0, 255, 136, 0.4)";

                timer = setInterval(() => {
                    balance += 0.0005;
                    document.getElementById('balance').innerText = balance.toFixed(4) + " STR";
                }, 1000);
            } else {
                isMining = false;
                statusText.innerText = "التعدين متوقف حالياً";
                statusText.style.color = "#8d99ae";
                statusText.style.borderColor = "rgba(0, 255, 136, 0.3)";
                btnText.innerText = "ابدأ";
                btnSub.innerText = "التعدين";
                miningBtn.style.boxShadow = "0 0 30px rgba(0, 255, 136, 0.15)";
                clearInterval(timer);
            }
        }
    </script>
</body>
</html>
